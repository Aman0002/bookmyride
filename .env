# ---- Copy to .env and fill in ----

# PostgreSQL connection string. Use a free host like Neon (neon.tech) or
# Supabase. Neon example (keep sslmode=require):
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# The same URL works for local dev and production.
DATABASE_URL="postgresql://neondb_owner:npg_F6faCRc3Iouq@ep-sparkling-lake-aiutfby8.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Random 32+ char string used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Google Maps (Places autocomplete + Geocoding). Leave blank in dev for the
# built-in Hisar-only fallback geocoder.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# Geoapify (places autocomplete + geocoding). Leave blank to use the local
# Hisar fallback suggestions until a key is added.
GEOAPIFY_API_KEY="e4b2fe1503494fc3baacf47c01b53af4"

# Razorpay. Leave blank in dev to use mock payments (auto-confirm).
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_T9pPluHP5M8jxE"
RAZORPAY_KEY_ID="rzp_test_T9pPluHP5M8jxE"
